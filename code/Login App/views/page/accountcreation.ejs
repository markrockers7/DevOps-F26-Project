<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Comp 4420 Login App</title>
    <meta name="description" content="Sample DB Connected Application for Comp 4420">
    <meta name="author" content="Comp 4420 + Mark Rockers">
    <!-- Bootstrap CSS Reset -->
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
 <!-- Content -->
    <div class="container">
		<h1>Create Account</h1>
        <% if (error) { %>
            <div class="alert alert-danger" role="alert">
                <%= error %>
            </div>
        <% } %>
        <form action="/api/attempt_account_creation" method="POST">
          Username: <input type="text" name="username" required><br>
          Password: <input type="text" name="password" required><br>
         <button type="submit">Create Account</button>
        </form>
    </div>
</body>
</html>



